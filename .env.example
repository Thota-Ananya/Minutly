# Copy this file to a new file named ".env" and fill in your own values.
# NEVER upload the real .env file to GitHub.

PORT=3000
NODE_ENV=development

# Your MongoDB Atlas connection string (database name "minutly" at the end)
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOURCLUSTER.mongodb.net/minutly?retryWrites=true&w=majority

# Any long random text. Used to sign login cookies. Keep it secret.
JWT_SECRET=change-this-to-a-long-random-text

# The packer / staff account that is created automatically the first time the server starts
STAFF_EMAIL=packer@minutly.local
STAFF_PASSWORD=ChangeMe@12345
